{
  "name": "projector",
  "version": "0.1.0-alpha.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm build:services && electron-vite dev",
    "build:services": "node scripts/build-services.mjs",
    "build": "pnpm build:services && electron-vite build",
    "start": "electron .",
    "package:mac": "pnpm build && node scripts/package-mac.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && node --test scripts/testing/*.test.mjs",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:visible": "pnpm build && playwright test --config playwright.full.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e",
    "check:full": "node scripts/testing/full.mjs",
    "hooks:install": "node scripts/testing/install-hook.mjs",
    "test:performance": "pnpm build && node scripts/testing/stage-performance.mjs",
    "postinstall": "node scripts/prepare-terminal.mjs",
    "storyboard:notifications": "node scripts/notifications-storyboard.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "mermaid": "^12.1.0",
    "node-pty": "1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "ws": "8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.7.0",
    "electron-vite": "5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
